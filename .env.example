# Supabase Cloud PostgreSQL connection strings.
# DATABASE_URL: pooled connection (PgBouncer, port 6543) — used by the running app.
# DIRECT_URL: direct connection (port 5432) — used by Prisma Migrate.
# Get both from Supabase Dashboard -> Project Settings -> Database -> Connection string.
# sslmode=no-verify: Supabase's pooler cert chain isn't in Node's default
# trust store — this still encrypts the connection, just skips CA validation.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=no-verify"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify"

# Supabase project API keys (only needed if/when Supabase Auth or Storage is used).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Demo-only role Quick Switcher (see .claude/skills/web-development/SKILL.md).
# Set to "false" for a real production deployment.
NEXT_PUBLIC_ENABLE_QUICK_SWITCHER="true"
